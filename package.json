{
  "name": "@bigbizze/semantic-values",
  "version": "0.0.0",
  "private": true,
  "description": "Opaque nominal values with validated immutable data and explicit reconstruction",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "import": "./dist/zod.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --test-timeout=5000 test/*.test.ts && node test/package.mjs",
    "check": "npm run build && npm run typecheck && npm test",
    "example": "node examples/usage.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "zod": "^4.6.7"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  }
}
